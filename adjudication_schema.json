{
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "APPROVE",
        "REJECT"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "verified",
              "rejected",
              "not_checked"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source",
          "result",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "decision",
    "rationale",
    "blocking_issues",
    "evidence_checks"
  ],
  "additionalProperties": false
}
